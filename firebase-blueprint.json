{
  "entities": {
    "Project": {
      "title": "Project",
      "description": "Portfolio work showcase and case study.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string", "maxLength": 200 },
        "slug": { "type": "string", "maxLength": 200 },
        "category": { "type": "string", "maxLength": 100 },
        "client": { "type": "string", "maxLength": 200 },
        "year": { "type": "string", "maxLength": 20 },
        "thumbnail": { "type": "string", "maxLength": 1000 },
        "images": { "type": "array" },
        "description": { "type": "string", "maxLength": 2000 },
        "featured": { "type": "boolean" },
        "order": { "type": "number" },
        "status": { "type": "string", "enum": ["published", "draft"] },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "title", "slug", "category", "client", "year", "thumbnail", "status"]
    },
    "ServiceItem": {
      "title": "ServiceItem",
      "description": "Studio creative discipline and capability.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "code": { "type": "string", "maxLength": 20 },
        "title": { "type": "string", "maxLength": 200 },
        "tagline": { "type": "string", "maxLength": 300 },
        "description": { "type": "string", "maxLength": 2000 },
        "deliverables": { "type": "array" },
        "tools": { "type": "array" },
        "order": { "type": "number" },
        "published": { "type": "boolean" }
      },
      "required": ["id", "code", "title", "published"]
    },
    "EditorialInsight": {
      "title": "EditorialInsight",
      "description": "Thought leadership essay and studio journal article.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "slug": { "type": "string", "maxLength": 200 },
        "title": { "type": "string", "maxLength": 300 },
        "excerpt": { "type": "string", "maxLength": 1000 },
        "content": { "type": "string", "maxLength": 50000 },
        "category": { "type": "string", "maxLength": 100 },
        "coverImage": { "type": "string", "maxLength": 1000 },
        "readTime": { "type": "string", "maxLength": 50 },
        "publishedAt": { "type": "string" },
        "tags": { "type": "array" },
        "isFeatured": { "type": "boolean" },
        "status": { "type": "string", "enum": ["published", "draft"] },
        "order": { "type": "number" }
      },
      "required": ["id", "slug", "title", "status"]
    },
    "ClientItem": {
      "title": "ClientItem",
      "description": "Client brand and collaboration partner.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string", "maxLength": 200 },
        "industry": { "type": "string", "maxLength": 150 },
        "year": { "type": "string", "maxLength": 20 },
        "logoUrl": { "type": "string", "maxLength": 10000 },
        "featured": { "type": "boolean" },
        "order": { "type": "number" },
        "scope": { "type": "array" },
        "overview": { "type": "string", "maxLength": 2000 },
        "results": { "type": "string", "maxLength": 1000 }
      },
      "required": ["id", "name", "industry", "featured"]
    },
    "HeroSlide": {
      "title": "HeroSlide",
      "description": "Hero carousel slide item.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "headline": { "type": "string", "maxLength": 200 },
        "subheadline": { "type": "string", "maxLength": 500 },
        "ctaText": { "type": "string", "maxLength": 100 },
        "ctaLink": { "type": "string", "maxLength": 200 },
        "desktopImage": { "type": "string", "maxLength": 1000 },
        "mobileImage": { "type": "string", "maxLength": 1000 },
        "categoryTag": { "type": "string", "maxLength": 100 },
        "order": { "type": "number" },
        "active": { "type": "boolean" }
      },
      "required": ["id", "headline", "desktopImage", "active"]
    },
    "SiteSettings": {
      "title": "SiteSettings",
      "description": "Studio global configuration and SEO/Telemetry settings.",
      "type": "object",
      "properties": {
        "studioName": { "type": "string", "maxLength": 200 },
        "tagline": { "type": "string", "maxLength": 300 },
        "email": { "type": "string", "maxLength": 200 },
        "phone": { "type": "string", "maxLength": 100 },
        "whatsapp": { "type": "string", "maxLength": 100 },
        "location": { "type": "string", "maxLength": 200 },
        "bio": { "type": "string", "maxLength": 2000 },
        "experienceYears": { "type": "number" },
        "completedProjects": { "type": "number" },
        "gaMeasurementId": { "type": "string", "maxLength": 100 },
        "gtmContainerId": { "type": "string", "maxLength": 100 },
        "metaPixelId": { "type": "string", "maxLength": 100 },
        "linkedInPartnerId": { "type": "string", "maxLength": 100 },
        "gtagEnabled": { "type": "boolean" },
        "ipAnonymization": { "type": "boolean" },
        "enhancedMeasurement": { "type": "boolean" },
        "seoTitle": { "type": "string", "maxLength": 300 },
        "seoDescription": { "type": "string", "maxLength": 1000 },
        "seoKeywords": { "type": "string", "maxLength": 1000 },
        "ogImageUrl": { "type": "string", "maxLength": 1000 },
        "twitterHandle": { "type": "string", "maxLength": 100 },
        "canonicalBaseUrl": { "type": "string", "maxLength": 500 },
        "indexingStatus": { "type": "string", "maxLength": 100 },
        "searchConsoleVerification": { "type": "string", "maxLength": 200 },
        "bingVerification": { "type": "string", "maxLength": 200 },
        "robotsTxtCustom": { "type": "string", "maxLength": 5000 }
      },
      "required": ["studioName", "email"]
    },
    "ContactInquiry": {
      "title": "ContactInquiry",
      "description": "Incoming prospective client brief or inquiry.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string", "maxLength": 200 },
        "company": { "type": "string", "maxLength": 200 },
        "email": { "type": "string", "maxLength": 200 },
        "phone": { "type": "string", "maxLength": 100 },
        "service": { "type": "string", "maxLength": 150 },
        "budget": { "type": "string", "maxLength": 100 },
        "timeline": { "type": "string", "maxLength": 100 },
        "description": { "type": "string", "maxLength": 5000 },
        "status": { "type": "string", "enum": ["new", "reviewed", "contacted", "archived"] },
        "createdAt": { "type": "string" }
      },
      "required": ["name", "email", "service", "description"]
    },
    "AdminRecord": {
      "title": "AdminRecord",
      "description": "Authorized administrator user.",
      "type": "object",
      "properties": {
        "email": { "type": "string", "maxLength": 200 },
        "role": { "type": "string", "enum": ["admin", "superadmin"] },
        "addedAt": { "type": "string" }
      },
      "required": ["email", "role"]
    }
  },
  "firestore": {
    "/projects/{projectId}": {
      "schema": "Project",
      "description": "Published and draft projects showcase."
    },
    "/services/{serviceId}": {
      "schema": "ServiceItem",
      "description": "Core creative disciplines and capabilities."
    },
    "/insights/{insightId}": {
      "schema": "EditorialInsight",
      "description": "Editorial essays and thought leadership pieces."
    },
    "/clients/{clientId}": {
      "schema": "ClientItem",
      "description": "Client directory and brand case studies."
    },
    "/sliders/{sliderId}": {
      "schema": "HeroSlide",
      "description": "Hero section dynamic carousel slides."
    },
    "/settings/{settingId}": {
      "schema": "SiteSettings",
      "description": "Site global configuration and settings."
    },
    "/inquiries/{inquiryId}": {
      "schema": "ContactInquiry",
      "description": "Client intake and project inquiries."
    },
    "/admins/{adminId}": {
      "schema": "AdminRecord",
      "description": "List of authorized studio administrators."
    }
  }
}
